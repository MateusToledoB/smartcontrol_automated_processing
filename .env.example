USER_MOTUS=seu_usuario
PASS_MOTUS=sua_senha
SHEET_ID_PROBLEMA_NO_EQUIPAMENTO=0000000000000000
SHEET_ID_APONTAMENTO_IMPAR=0000000000000000
SHEET_ID_TEMPORARIOS=0000000000000000
SMARTSHEET_TOKEN=00000000000000

# Driver Selenium — obrigatorio rodar localmente no Windows (producao/Docker
# fixa esses paths no Dockerfile, mas dev local precisa deles no .env).
# Ver padrao completo em contextualizing_my_mind/patterns/rpa/driver-factory.md
CHROME_HEADLESS_SHELL_PATH=C:\ferramentas\chrome-headless-shell-win64\chrome-headless-shell.exe
CHROMEDRIVER_PATH=C:\ferramentas\chromedriver-win64\chromedriver.exe

# Debug local opcional: alterna para o Chrome completo (janela visivel) em vez
# do chrome-headless-shell. Deixe SHOW_BROWSER=false em producao.
SHOW_BROWSER=false
CHROME_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROMEDRIVER_BROWSER_PATH=C:\ferramentas\chromedriver-browser-win64\chromedriver-win64\chromedriver.exe
